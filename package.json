{
  "name": "kokoro-tts-mcp",
  "version": "1.0.0",
  "description": "Cross-platform local text-to-speech MCP server using Kokoro. Works on Windows, macOS, and Linux. Free, offline, no API keys.",
  "main": "dist/index.js",
  "bin": {
    "kokoro-tts-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test test/config.test.cjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "init": "node dist/cli.js init",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tts",
    "text-to-speech",
    "kokoro",
    "kokoro-tts",
    "local",
    "offline",
    "voice",
    "speech",
    "claude",
    "claude-code",
    "claude-mcp",
    "zcode",
    "cursor",
    "windows",
    "macos",
    "linux",
    "cross-platform",
    "ai"
  ],
  "author": "Kalpraj Solutions <https://github.com/kalprajsolutions>",
  "license": "Apache-2.0",
  "type": "commonjs",
  "files": [
    "dist/",
    "python/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalprajsolutions/kokoro-tts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kalprajsolutions/kokoro-tts-mcp/issues"
  },
  "homepage": "https://github.com/kalprajsolutions/kokoro-tts-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
